# bc4-back/deploy/.env.example
#
# Modèle pour /home/devmat/BC4/.env (chmod 600, HORS GIT).
# Valeurs ici FACTICES — remplacer par des secrets générés aléatoirement.
# Les trois variables marquées REQUIRED font échouer `docker compose up`
# si absentes (fail-fast via ${VAR:?...}).

# ===== PostgreSQL =====
# Rôle `bc4` sur la DB `bc4`. REQUIRED. Générer :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32B_URLSAFE

# Même valeur que POSTGRES_PASSWORD. REQUIRED. Utilisé pour construire
# BC4_DSN = postgresql+psycopg://bc4:${BC4_PGPW}@db:5432/bc4
BC4_PGPW=REPLACE_WITH_RANDOM_32B_URLSAFE

# ===== JWT =====
# Secret HS256 pour signer les tokens d'authentification. REQUIRED.
# Générer :
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
BC4_JWT_SECRET=REPLACE_WITH_RANDOM_64B_URLSAFE

BC4_JWT_TTL_MIN=60

# ===== Admin seedé (optionnel) =====
# Si posés, `python -m app.seed.run` crée un admin idempotent sur email.
BC4_ADMIN_EMAIL=admin@bc4.local
BC4_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_OR_LEAVE_UNSET

# ===== Compte démo (optionnel) =====
BC4_DEMO_EMAIL=
BC4_DEMO_PASSWORD=
BC4_DEMO_ROLE=ingenieur

# ===== CORS =====
# Liste CSV. localhost:8080 pour tests dev local, 5174 pour UI prod,
# lovable.app pour l'onglet du concepteur. Pas d'IP publique en 8080
# (API bindée 127.0.0.1 depuis 2026-10-27).
BC4_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8080,https://franco-focus-forge.lovable.app

# ===== LLM Fernet (optionnel) =====
# Clé de chiffrement de settings_llm.api_key_cipher au repos.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BC4_LLM_SECRET_KEY=

# ===== Seed démo complet (optionnel) =====
# 0 par défaut (0.89.4+) : zéro projet démo, zéro users dépréciée,
# zéro measurement_points/rrc_observations générés par fixtures.
# Mettre 1 pour une install de démonstration qui pose les 6 projets fictifs.
BC4_SEED_DEMO=0
