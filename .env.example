BC4_DSN=postgresql+psycopg://bc4:bc4@localhost:5432/bc4
BC4_ENV=development
BC4_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# JWT (B2). SECRET obligatoire — l'API refuse de démarrer sans.
# Génère-en un propre : `python -c "import secrets; print(secrets.token_urlsafe(48))"`
BC4_JWT_SECRET=change-me-in-prod-use-a-real-secret
BC4_JWT_TTL_MIN=60

# Seed admin idempotent. Si l'un des deux manque, le seed est sauté
# (pas d'invention de compte admin, écart déclaré).
BC4_ADMIN_EMAIL=admin@bc4.local
BC4_ADMIN_PASSWORD=change-me-admin

# Seed démo idempotent (optionnel). Rôle `ingenieur` par défaut, override
# via BC4_DEMO_ROLE ∈ {admin, ingenieur, lecteur}. Jamais demo/demo en dur.
# BC4_DEMO_EMAIL=demo@bc4.local
# BC4_DEMO_PASSWORD=change-me-demo
# BC4_DEMO_ROLE=ingenieur

# LLM (0.16.0). Précédence : DB (/settings/llm) > ces env. La clé
# Fernet chiffre l'api_key stockée en base. Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BC4_LLM_SECRET_KEY=
# Valeurs par défaut utilisées quand `settings_llm` est vide en base.
# BC4_LLM_PROVIDER=openai
# BC4_LLM_BASE_URL=https://api.openai.com/v1
# BC4_LLM_MODEL=gpt-4o-mini
# BC4_LLM_API_KEY=
# BC4_LLM_ENABLED=false
